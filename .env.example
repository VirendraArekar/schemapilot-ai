# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Database (MySQL 8)
DATABASE_URL="mysql://schemapilot:schemapilot_pass@localhost:3306/schemapilot_db"

# Redis (BullMQ & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_strong_64_char_access_secret_key
JWT_REFRESH_SECRET=replace_with_strong_64_char_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_strong_cookie_secret
ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key_0123456789abcdef
CSRF_SECRET=replace_with_csrf_secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# AI Provider (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# S3-Compatible Storage (MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=schemapilot-exports
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Frontend
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
